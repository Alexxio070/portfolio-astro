---
const year = new Date().getFullYear();
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Portfolio en construcción. Vuelve pronto." />
		<title>Portfolio · En construcción</title>
	</head>
	<body>
		<div class="grid-bg" aria-hidden="true"></div>

		<main>
			<div class="tape" aria-hidden="true">
				<span>EN CONSTRUCCIÓN · EN CONSTRUCCIÓN · EN CONSTRUCCIÓN · EN CONSTRUCCIÓN · EN CONSTRUCCIÓN · </span>
			</div>

			<section class="card">
				<p class="badge"><span class="dot"></span> Trabajando en ello</p>
				<h1>Algo está <span class="accent">en obras</span>.</h1>
				<p class="lead">
					Estoy construyendo mi portfolio. Pronto encontrarás aquí mis proyectos,
					experiencia y formas de contactarme.
				</p>

				<div class="progress" role="progressbar" aria-label="Progreso" aria-valuemin="0" aria-valuemax="100" aria-valuenow="35">
					<div class="bar"></div>
				</div>
				<p class="terminal"><span class="prompt">$</span> npm run build-portfolio<span class="cursor">_</span></p>
			</section>
		</main>

		<footer>© {year} · Hecho con Astro</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg: #0e0f13;
		--surface: #16181f;
		--border: #2a2d38;
		--text: #e8e9ee;
		--muted: #9a9db0;
		--accent: #f5b301;
		--stripe-dark: #1a1a1a;
		color-scheme: dark;
	}
	@media (prefers-color-scheme: light) {
		:root {
			--bg: #f6f5f1;
			--surface: #ffffff;
			--border: #e2e0d8;
			--text: #1a1b20;
			--muted: #5d6070;
			--accent: #d99a00;
			color-scheme: light;
		}
	}
	* { box-sizing: border-box; margin: 0; }
	html, body { min-height: 100%; }
	body {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background: var(--bg);
		color: var(--text);
		font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
		overflow-x: hidden;
	}
</style>

<style>
	.grid-bg {
		position: fixed;
		inset: 0;
		background-image:
			linear-gradient(var(--border) 1px, transparent 1px),
			linear-gradient(90deg, var(--border) 1px, transparent 1px);
		background-size: 40px 40px;
		mask-image: radial-gradient(ellipse at center, #000 20%, transparent 70%);
		opacity: 0.5;
		pointer-events: none;
	}

	main {
		flex: 1;
		display: grid;
		place-items: center;
		padding: 4rem 1rem 2rem;
		position: relative;
	}

	.tape {
		position: absolute;
		top: 2.5rem;
		left: -5%;
		width: 110%;
		transform: rotate(-3deg);
		background: repeating-linear-gradient(
			-45deg,
			var(--accent) 0 24px,
			var(--stripe-dark) 24px 48px
		);
		padding: 6px 0;
		overflow: hidden;
		box-shadow: 0 6px 20px rgb(0 0 0 / 0.25);
	}
	.tape span {
		display: inline-block;
		white-space: nowrap;
		background: var(--accent);
		color: #111;
		font-weight: 800;
		letter-spacing: 0.15em;
		font-size: 0.85rem;
		padding: 4px 0;
		animation: marquee 30s linear infinite;
	}
	@keyframes marquee {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}

	.card {
		position: relative;
		width: 100%;
		max-width: 560px;
		margin-top: 4rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 2.5rem 2rem;
		box-shadow: 0 20px 50px rgb(0 0 0 / 0.15);
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
		color: var(--muted);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.3rem 0.8rem;
		margin-bottom: 1.5rem;
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent);
		animation: pulse 1.6s ease-in-out infinite;
	}
	@keyframes pulse {
		50% { opacity: 0.3; }
	}

	h1 {
		font-size: clamp(2rem, 6vw, 3rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin-bottom: 1rem;
	}
	.accent { color: var(--accent); }

	.lead {
		color: var(--muted);
		line-height: 1.6;
		margin-bottom: 2rem;
	}

	.progress {
		height: 8px;
		background: var(--border);
		border-radius: 999px;
		overflow: hidden;
		margin-bottom: 1.25rem;
	}
	.bar {
		height: 100%;
		width: 35%;
		background: repeating-linear-gradient(
			-45deg,
			var(--accent) 0 10px,
			color-mix(in srgb, var(--accent) 70%, transparent) 10px 20px
		);
		background-size: 28px 28px;
		border-radius: inherit;
		animation: stripes 1s linear infinite;
	}
	@keyframes stripes {
		to { background-position: 28px 0; }
	}

	.terminal {
		font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
		font-size: 0.85rem;
		color: var(--muted);
	}
	.prompt { color: var(--accent); margin-right: 0.4rem; }
	.cursor { animation: blink 1s step-end infinite; }
	@keyframes blink {
		50% { opacity: 0; }
	}

	footer {
		text-align: center;
		padding: 1.5rem 1rem;
		font-size: 0.8rem;
		color: var(--muted);
		position: relative;
	}

	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after { animation: none !important; }
	}
</style>
