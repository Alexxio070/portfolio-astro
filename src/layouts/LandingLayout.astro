---
/**
 * LandingLayout
 * Layout wrapper for the single-page home: the floating navigation bar and no footer.
 */
import BaseLayout from './BaseLayout.astro';
import FloatingNav from '@/components/layout/FloatingNav.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  includePersonSchema?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  nofollow = false,
  includePersonSchema = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
  includePersonSchema={includePersonSchema}
>
  <FloatingNav slot="header" />

  <slot />
</BaseLayout>
