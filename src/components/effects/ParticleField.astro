---
/**
 * ParticleField
 * A swarm of small programming symbols drifting behind the hero — braces,
 * brackets, operators and digits — in three tones of the active colour theme.
 * Each is sized by its depth, so the far ones read as specks and the near ones
 * as legible glyphs; a few carry a soft halo. Without the cursor the swarm
 * follows a slow flow field, so it streams in broad curves rather than moving
 * in straight lines.
 *
 * The glyphs are drawn once per symbol and tone into small offscreen canvases
 * and stamped from there, so a field of several hundred costs about what the
 * plain dots did.
 *
 * The cursor collects. Stars that come near are drawn in and gather into a
 * loose, slowly turning shell around it, which follows wherever it goes — a
 * very soft gravity well that deforms the stream behind it. It keeps each star
 * for about a second, then lets go all at once: the pull stops, the star is
 * nudged outwards and scatters off on its own momentum, picks the flow back
 * up and falls away down the page, while others are caught in its place.
 * Nothing is fired and nothing collides; the pull is continuous and has
 * inertia, so the swarm settles back into its fall once the cursor stops.
 *
 * Colours come from the active colour theme (`--color-brand-50`, `-200` and
 * `-400`) and are re-read when the theme or the colour mode changes.
 *
 * It stays out of the way:
 *  - Pauses when scrolled out of view or when the tab is hidden.
 *  - Under prefers-reduced-motion it draws one still frame and never animates.
 *  - The pointer only affects it with a mouse or pen, not on touch screens.
 *  - Fewer stars on small screens; capped at a pixel ratio of 2.
 *
 * Requirements:
 *  - Parent must be `position: relative` (the hero section is).
 *  - Put it in the hero's `background` slot, under the content.
 */
interface Props {
  /** Extra classes for the canvas. */
  class?: string;
}

const { class: className } = Astro.props;
---

<canvas class:list={['particle-field', className]} aria-hidden="true"></canvas>

<style>
  .particle-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /* The tech-stack row sits at the foot of the hero; keep it clean. */
    mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%);
    animation: particle-field-in 1.6s ease-out both;
  }
  @keyframes particle-field-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .particle-field {
      animation: none;
    }
  }
</style>

<script>
  type Rgb = [number, number, number];

  interface Star {
    x: number;
    y: number;
    vx: number;
    vy: number;
    /** Cruising speed along the flow field. */
    speed: number;
    /** Offset to the flow angle, so neighbours do not all take the same path. */
    phase: number;
    /** Size the glyph is drawn at, in pixels. */
    r: number;
    /** Depth, 0.4 (far) to 1 (near). */
    z: number;
    /** Index into SYMBOLS. */
    sym: number;
    /** Index into the three tones. */
    tone: number;
    /** Larger stars carry a soft halo. */
    halo: boolean;
    twinkle: number;
    /** Milliseconds left in the cursor's hold; 0 when free. */
    held: number;
    /** How far under the cursor's pull it is, 0 to 1. Eased, so letting go is gradual. */
    grab: number;
    /** Milliseconds before it can be caught again, so a star it has just thrown
     *  off is not pulled straight back in. */
    cool: number;
  }

  const TONE_VARS = ['--color-brand-200', '--color-brand-50', '--color-brand-400'];
  // Single characters on purpose: a pair like `=>` turns to mush at the size
  // most of these are drawn at.
  const SYMBOLS = [
    '{', '}', '(', ')', '[', ']', '<', '>', '/', '*', ';', '=',
    '+', '-', '&', '|', '!', '?', '#', '$', '_', '0', '1', ':',
  ];
  /** Resolution the glyph sprites are drawn at before being scaled down. */
  const GLYPH_PX = 48;

  /** Resolves any CSS colour to RGB; falls back to white if it cannot be parsed. */
  function toRgb(css: string): Rgb {
    const probe = document.createElement('canvas').getContext('2d', { willReadFrequently: true });
    if (!probe) return [255, 255, 255];
    probe.fillStyle = '#fff';
    probe.fillStyle = css;
    probe.fillRect(0, 0, 1, 1);
    const d = probe.getImageData(0, 0, 1, 1).data;
    return [d[0], d[1], d[2]];
  }

  /**
   * Direction of the flow field at a point, in radians. Three slow waves that
   * drift over time: smooth enough that nearby stars move alike, varied enough
   * that they do not all end up in one place.
   */
  function flowAngle(x: number, y: number, t: number): number {
    const a =
      Math.sin(x * 0.0021 + t * 0.00011) +
      Math.cos(y * 0.0027 - t * 0.00009) +
      Math.sin((x + y) * 0.0015 + t * 0.00007);
    return a * 1.6;
  }

  function init(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    const host = canvas.parentElement;
    if (!ctx || !host) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

    const CATCH_RADIUS = 135;
    /** Radius of the shell the caught stars gather on, before depth. */
    const SHELL = 26;
    /** How long a star is held, in milliseconds. */
    const HOLD = 1000;
    const HOLD_SPREAD = 300;
    /** Cap on how many are held at once, so the swarm is never emptied. */
    const MAX_HELD = 80;
    /** Base downward drift, so a freed star falls away down the page. */
    const FALL = 0.16;
    const MARGIN = 20;
    const MAX_SPEED = 4;

    let w = 0;
    let h = 0;
    const stars: Star[] = [];
    let tones: Rgb[] = [
      [255, 255, 255],
      [255, 255, 255],
      [255, 255, 255],
    ];
    let sprites: HTMLCanvasElement[] = [];
    /** Glyph sprites, by tone then by symbol. */
    let glyphs: HTMLCanvasElement[][] = [];
    let running = false;
    let visible = true;
    let raf = 0;
    let last = 0;
    let clock = 0;
    const pointer = { x: 0, y: 0, vx: 0, vy: 0, active: false, strength: 0, moved: 0 };

    const swatch = document.createElement('span');
    swatch.setAttribute('aria-hidden', 'true');
    swatch.style.display = 'none';
    host.appendChild(swatch);

    const rgba = (c: Rgb, a: number) => `rgba(${c[0]},${c[1]},${c[2]},${a})`;

    /** A soft round glow, drawn once per tone and stamped for every halo. */
    function makeSprite(color: Rgb): HTMLCanvasElement {
      const size = 64;
      const sprite = document.createElement('canvas');
      sprite.width = size;
      sprite.height = size;
      const c = sprite.getContext('2d');
      if (c) {
        const g = c.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
        g.addColorStop(0, rgba(color, 0.9));
        g.addColorStop(0.25, rgba(color, 0.28));
        g.addColorStop(1, rgba(color, 0));
        c.fillStyle = g;
        c.fillRect(0, 0, size, size);
      }
      return sprite;
    }

    /** One symbol in one tone, drawn large so it stays crisp when scaled down. */
    function makeGlyph(symbol: string, color: Rgb): HTMLCanvasElement {
      const sprite = document.createElement('canvas');
      sprite.width = GLYPH_PX;
      sprite.height = GLYPH_PX;
      const c = sprite.getContext('2d');
      if (c) {
        c.font = `600 ${GLYPH_PX * 0.7}px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace`;
        c.textAlign = 'center';
        c.textBaseline = 'middle';
        c.fillStyle = rgba(color, 1);
        c.fillText(symbol, GLYPH_PX / 2, GLYPH_PX / 2);
      }
      return sprite;
    }

    function readColors() {
      tones = TONE_VARS.map((name) => {
        swatch.style.color = `var(${name})`;
        return toRgb(getComputedStyle(swatch).color);
      });
      sprites = tones.map(makeSprite);
      glyphs = tones.map((tone) => SYMBOLS.map((symbol) => makeGlyph(symbol, tone)));
    }

    function scrollShift() {
      return reduced.matches ? 0 : Math.min(window.scrollY, window.innerHeight * 1.2) * 0.06;
    }

    function spawn(): Star {
      const z = 0.4 + Math.random() * 0.6;
      const x = Math.random() * w;
      const y = Math.random() * h;
      const speed = (0.12 + Math.random() * 0.26) * z;
      const phase = (Math.random() - 0.5) * 0.9;
      const angle = flowAngle(x, y, 0) + phase;
      const roll = Math.random();
      return {
        x,
        y,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed + FALL * z,
        speed,
        phase,
        r: (12 + Math.random() * 11) * (0.55 + 0.45 * z),
        z,
        tone: roll < 0.55 ? 0 : roll < 0.88 ? 1 : 2,
        sym: Math.floor(Math.random() * SYMBOLS.length),
        halo: Math.random() < 0.06,
        twinkle: Math.random() * Math.PI * 2,
        held: 0,
        grab: 0,
        cool: 0,
      };
    }

    function resize() {
      const nw = canvas.clientWidth;
      const nh = canvas.clientHeight;
      if (!nw || !nh) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(nw * dpr);
      canvas.height = Math.round(nh * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      if (w && h) {
        for (const s of stars) {
          s.x *= nw / w;
          s.y *= nh / h;
        }
      }
      w = nw;
      h = nh;

      const density = finePointer.matches ? 1 : 0.55;
      const target = Math.round(Math.min(380, Math.max(90, (w * h) / 5200)) * density);
      while (stars.length < target) stars.push(spawn());
      if (stars.length > target) stars.length = target;
    }

    function step(dt: number) {
      clock += dt;
      const k = dt / 16.67;
      pointer.strength += ((pointer.active ? 1 : 0) - pointer.strength) * Math.min(1, 0.07 * k);
      // The cursor's own velocity, smoothed, in pixels per frame.
      pointer.vx *= Math.exp(-dt / 140);
      pointer.vy *= Math.exp(-dt / 140);
      const shift = scrollShift();
      const collecting = pointer.strength > 0.35;
      let held = 0;
      for (const s of stars) if (s.held > 0) held++;

      for (const s of stars) {
        // The hold runs down on its own; once it ends the star rests before it
        // can be caught again, so the cursor keeps gathering new ones instead
        // of dragging the same handful around for ever.
        const sy = s.y - shift * s.z;
        const dx = s.x - pointer.x;
        const dy = sy - pointer.y;
        const d = Math.hypot(dx, dy) || 1;

        if (s.held > 0) {
          s.held -= dt;
          if (s.held <= 0) {
            s.cool = 3000;
            // Letting go: the pull stops at once and the star is nudged
            // outwards, so the cloud scatters off the cursor instead of
            // quietly falling out of step with it. What it keeps is its own
            // momentum, which is what carries it back into the fall.
            s.grab = 0;
            const push = (1.3 + Math.random() * 0.9) * (0.7 + 0.3 * s.z);
            s.vx += (dx / d) * push;
            s.vy += (dy / d) * push;
          }
        } else if (s.cool > 0) {
          s.cool -= dt;
        }

        if (collecting && s.held <= 0 && s.cool <= 0 && held < MAX_HELD && d < CATCH_RADIUS) {
          s.held = HOLD + Math.random() * HOLD_SPREAD;
          held++;
        }
        if (s.held > 0) s.grab += (1 - s.grab) * Math.min(1, 0.045 * k);

        // Free drift: the flow field, plus a slow fall down the page.
        const angle = flowAngle(s.x, s.y, clock) + s.phase;
        const freeVx = Math.cos(angle) * s.speed;
        const freeVy = Math.sin(angle) * s.speed + FALL * s.z;
        s.vx += (freeVx - s.vx) * 0.035 * (1 - s.grab) * k;
        s.vy += (freeVy - s.vy) * 0.035 * (1 - s.grab) * k;

        if (s.grab > 0.01) {
          // Held: a spring towards a shell around the cursor rather than the
          // cursor itself, so they gather into a cloud instead of collapsing
          // into one point. Add a little swirl, and carry them along with it.
          const nx = dx / d;
          const ny = dy / d;
          const shell = SHELL * (0.6 + 0.9 * s.z);
          const wantVx = (pointer.x + nx * shell - s.x) * 0.05 - ny * 0.4 + pointer.vx * 0.18;
          const wantVy = (pointer.y + ny * shell - sy) * 0.05 + nx * 0.4 + pointer.vy * 0.18;
          s.vx += (wantVx - s.vx) * 0.085 * s.grab * k;
          s.vy += (wantVy - s.vy) * 0.085 * s.grab * k;
        }

        const speed = Math.hypot(s.vx, s.vy);
        if (speed > MAX_SPEED) {
          s.vx *= MAX_SPEED / speed;
          s.vy *= MAX_SPEED / speed;
        }
        s.x += s.vx * k;
        s.y += s.vy * k;

        if (s.x < -MARGIN) s.x = w + MARGIN;
        else if (s.x > w + MARGIN) s.x = -MARGIN;
        if (s.y < -MARGIN) s.y = h + MARGIN;
        else if (s.y > h + MARGIN) s.y = -MARGIN;
      }
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);
      // Nearer stars shift more as the page scrolls, which is what gives the
      // layers their depth. Clamped so a long scroll cannot fling them away.
      const shift = scrollShift();

      // A faint glow where the cursor is, so the swarm has something to part around.
      if (pointer.strength > 0.01) {
        const s = pointer.strength;
        const glow = ctx!.createRadialGradient(pointer.x, pointer.y, 0, pointer.x, pointer.y, CATCH_RADIUS);
        glow.addColorStop(0, rgba(tones[1], 0.12 * s));
        glow.addColorStop(1, rgba(tones[1], 0));
        ctx!.fillStyle = glow;
        ctx!.fillRect(pointer.x - CATCH_RADIUS, pointer.y - CATCH_RADIUS, CATCH_RADIUS * 2, CATCH_RADIUS * 2);
      }

      for (const s of stars) {
        const y = s.y - shift * s.z;
        const tw = reduced.matches ? 1 : 0.85 + 0.15 * Math.sin(clock * 0.002 + s.twinkle);
        const alpha = Math.min(1, (0.45 + 0.55 * s.z) * tw * (1 + 0.25 * s.grab));
        if (s.halo) {
          const size = s.r * 2.6;
          ctx!.globalAlpha = 0.55 * s.z * tw;
          ctx!.drawImage(sprites[s.tone], s.x - size / 2, y - size / 2, size, size);
        }
        ctx!.globalAlpha = alpha;
        ctx!.drawImage(glyphs[s.tone][s.sym], s.x - s.r / 2, y - s.r / 2, s.r, s.r);
      }
      ctx!.globalAlpha = 1;
    }

    function frame(now: number) {
      raf = 0;
      if (!running) return;
      const dt = Math.min(now - last, 50);
      last = now;
      step(dt);
      draw();
      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (running) return;
      running = true;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      running = false;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    function update() {
      if (visible && !document.hidden && !reduced.matches) start();
      else stop();
      if (!running) draw();
    }

    function onMove(e: PointerEvent) {
      if (reduced.matches || e.pointerType === 'touch') return;
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const now = performance.now();
      if (pointer.active && pointer.moved) {
        const dt = Math.max(8, now - pointer.moved);
        // Pixels per frame, blended in so a single jittery event cannot jerk the swarm.
        pointer.vx += ((x - pointer.x) / dt) * 16.67 * 0.4;
        pointer.vy += ((y - pointer.y) / dt) * 16.67 * 0.4;
        const speed = Math.hypot(pointer.vx, pointer.vy);
        if (speed > 24) {
          pointer.vx *= 24 / speed;
          pointer.vy *= 24 / speed;
        }
      }
      pointer.x = x;
      pointer.y = y;
      pointer.moved = now;
      pointer.active = true;
    }

    readColors();
    resize();
    update();

    new ResizeObserver(() => {
      resize();
      if (!running) draw();
    }).observe(canvas);
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      update();
    }).observe(canvas);
    new MutationObserver(() => {
      readColors();
      if (!running) draw();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });

    document.addEventListener('visibilitychange', update);
    reduced.addEventListener('change', update);
    host.addEventListener('pointermove', onMove);
    host.addEventListener('pointerleave', () => {
      pointer.active = false;
      pointer.moved = 0;
    });
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.particle-field').forEach(init);
</script>
