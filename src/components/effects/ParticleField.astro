---
/**
 * ParticleField
 * A swarm of small programming symbols drifting behind the hero — braces,
 * brackets, operators and digits — in three tones of the active colour theme.
 * Each is sized by its depth, so the far ones read as specks and the near ones
 * as legible glyphs; a few carry a soft halo. Without the cursor the swarm
 * follows a slow flow field, so it streams in broad curves rather than moving
 * in straight lines.
 *
 * The glyphs are drawn once per symbol and tone into small offscreen canvases
 * and stamped from there, so a field of several hundred costs about what the
 * plain dots did.
 *
 * The cursor sows an eddy. Where it lingers, the stars it catches gather round
 * a still centre left there, not the cursor itself, in two moments that read
 * differently. First they form: each glides in from where it was caught,
 * dimmer, to a place of its own on the spiral's arm. Then the spiral is
 * formed: every star sits on the arm, lit, and the whole spiral turns slowly
 * and steadily as one, for a few seconds, before the star is let go and the
 * spiral slowly opens out and lets it drift off. While a spiral is there,
 * everything the cursor catches, wherever it is, goes to it, travelling there
 * at an unhurried pace; a new spiral is only sown once the last has gone. A
 * spiral is a single arm wound a few times round its centre, evenly spaced,
 * and stars take their places on it from the centre outwards, so it grows
 * out as it fills and always reads as one continuous arm. A young spiral also
 * draws in the free stars that pass close to it, the free
 * stars around it are slowly turned about it, and the stars on it leave a short faint trail as they go. Every star a
 * spiral takes is replaced by a new one fading in elsewhere, and the extra
 * ones fade away once the spiral lets them go, so the field never thins out. Moving
 * quickly the cursor catches nothing and only tugs: near the spiral it bends
 * the stars towards it, and once it moves away they settle back onto their
 * arms. Everything that follows something here — each star
 * following its place on its orbit, the point the cursor's tug aims at — is a
 * critically damped spring, so it arrives without overshooting and its speed
 * never changes abruptly; the orbit's pull also fades in and out.
 *
 * It opens in depth: the far layers appear first and the near ones after.
 * Scrolling past the hero thins the field out and hurries it along, so the
 * hero dissolves into the page below instead of being cut off.
 *
 * Behind the text it marks with `data-particle-calm` the field fades back, so
 * the words lead and the swarm only accompanies them. The glyphs are drawn in
 * the site's own monospace face.
 *
 * Colours come from the active colour theme (`--color-brand-50`, `-200` and
 * `-400`) and are re-read when the theme or the colour mode changes.
 *
 * It stays out of the way:
 *  - Pauses when scrolled out of view or when the tab is hidden.
 *  - Under prefers-reduced-motion it draws one still frame and never animates.
 *  - The pointer only affects it with a mouse or pen, not on touch screens.
 *  - Fewer stars on small screens; capped at a pixel ratio of 2.
 *
 * Requirements:
 *  - Parent must be `position: relative` (the hero section is).
 *  - Put it in the hero's `background` slot, under the content.
 */
interface Props {
  /** Extra classes for the canvas. */
  class?: string;
}

const { class: className } = Astro.props;
---

<canvas class:list={['particle-field', className]} aria-hidden="true"></canvas>

<style>
  .particle-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /* The tech-stack row sits at the foot of the hero; keep it clean. */
    mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%);
  }
</style>

<script>
  type Rgb = [number, number, number];

  /** The still centre an eddy of caught stars orbits. */
  interface Well {
    x: number;
    y: number;
    /** How many stars it holds, counted each frame. */
    stars: number;
    /** How far the formed spiral has turned, in radians. */
    spin: number;
    /** Which places along its arm are taken, from the centre out. */
    taken: boolean[];
    /** Milliseconds since it was sown. */
    age: number;
    /** 0 to 1: rises while it has stars and falls once it is empty, so the
     *  turning of the field around it comes and goes gently. */
    presence: number;
  }

  interface Star {
    x: number;
    y: number;
    vx: number;
    vy: number;
    /** Cruising speed along the flow field. */
    speed: number;
    /** Offset to the flow angle, so neighbours do not all take the same path. */
    phase: number;
    /** Size the glyph is drawn at, in pixels. */
    r: number;
    /** Depth, 0.4 (far) to 1 (near). */
    z: number;
    /** Index into SYMBOLS. */
    sym: number;
    /** Index into the three tones. */
    tone: number;
    /** Larger stars carry a soft halo. */
    halo: boolean;
    twinkle: number;
    /** Milliseconds left in the cursor's hold; 0 when free. */
    held: number;
    /** How far under the cursor's pull it is, 0 to 1. Eased, so letting go is gradual. */
    grab: number;
    /** Milliseconds before it can be caught again, so a star it has just thrown
     *  off is not pulled straight back in. */
    cool: number;
    /** While held: how far crowding has turned it along its arm, in radians,
     *  the distance it was caught at, and how long it has been held, in
     *  milliseconds. */
    orbit: number;
    caughtAt: number;
    /** How long its orbit lasts, in milliseconds. */
    life: number;
    /** Its place on the spiral: the radius, and the angle on the spiral's own
     *  turning frame. */
    slotR: number;
    /** Which place along the arm it holds, or -1. */
    slot: number;
    relTarget: number;
    /** While forming it travels straight round from the angle it was caught
     *  at to where its place will be when it arrives, both absolute. */
    angle0: number;
    angle1: number;
    /** How far it has formed into the spiral, 0 to 1, and how long forming
     *  takes it, in milliseconds: longer the further it has to travel. */
    form: number;
    formDur: number;
    age: number;
    /** Pixels in or out from its orbit, where crowding has moved it. Eases back. */
    ringOffset: number;
    /** The eddy it orbits, while held or being let go. */
    well: Well | null;
    /** When it was made, on the field's clock, so a new star fades in. */
    born: number;
    /** A star made to replace one a spiral took is retired once there are too
     *  many: it fades from 1 to 0 and is then removed. */
    retire: boolean;
    gone: number;
    /** Its last few positions while on a spiral, as x, y pairs, for its trail. */
    trail: number[];
  }

  const TONE_VARS = ['--color-brand-200', '--color-brand-50', '--color-brand-400'];
  // Single characters on purpose: a pair like `=>` turns to mush at the size
  // most of these are drawn at.
  const SYMBOLS = [
    '{', '}', '(', ')', '[', ']', '<', '>', '/', '*', ';', '=',
    '+', '-', '&', '|', '!', '?', '#', '$', '_', '0', '1', ':',
  ];
  /** Resolution the glyph sprites are drawn at before being scaled down. */
  const GLYPH_PX = 48;

  /**
   * How the swarm behaves around the cursor and on its own, in one place so the
   * feel of it can be tuned without reading through the simulation.
   */
  const tune = {
    /** How near a star must pass to be caught, in pixels. */
    catchRadius: 110,
    /** Radius at which the spiral's arm starts and ends, in pixels, and how
     *  many times it winds round in between, evenly spaced. */
    spiralInner: 10,
    spiralOuter: 90,
    spiralTurns: 3,
    /** Turns per second of a formed spiral, which turns as one. */
    orbitSpeed: 0.25,
    /** How much a formed spiral breathes. */
    breathe: 0.06,
    /** Milliseconds a caught star takes to reach its place on the spiral. */
    formTime: 1600,
    /** Speed, in pixels per second, at which a star caught far from the spiral
     *  travels to it; forming takes longer the further it has to go. */
    travelSpeed: 160,
    /** How much of its glow a star shows while still forming. */
    formGlow: 0.35,
    /** How far out the spiral carries a star as it is let go, as a multiple of
     *  the outer radius. */
    spiralOut: 1.4,
    /** How briskly the point the swarm orbits follows the cursor, in hertz.
     *  It is a critically damped spring: it irons out the cursor's jumps and
     *  never overshoots. */
    anchorHz: 2.2,
    /** How briskly a held star follows its place on the orbit, in hertz. Also
     *  critically damped, so its speed never changes abruptly. */
    followHz: 1.8,
    /** Milliseconds the orbit's pull takes to come on once a star is caught,
     *  and to let go of it, so neither moment is a jolt. */
    gripIn: 400,
    gripOut: 1200,
    /** Speed a held star is eased back towards if it goes faster, in pixels
     *  per frame. Soft: it slows down rather than being clipped. */
    heldMaxSpeed: 4,
    /** Share of any excess speed taken off per frame. Low values brake gently. */
    brake: 0.15,
    /** The cursor only catches stars while it moves slower than this, in
     *  pixels per second, so eddies are left where it lingers, not strewn
     *  along every path. */
    sowSpeed: 450,
    /** Milliseconds the cursor has to linger before it catches anything, so
     *  merely entering the hero does not sow a spiral where it came in. */
    sowDelay: 450,
    /** A new spiral is kept this far inside the visible part of the hero, in
     *  pixels, clear of the navigation bar at the top. The field fades out
     *  towards the foot of the hero, so it stays above that too. */
    sowInset: 110,
    sowTop: 140,
    /** How strongly the cursor bends a nearby eddy's stars towards it (0 to 1),
     *  and from how far, in pixels. */
    tug: 0.55,
    tugRadius: 150,
    /** Most stars a spiral holds; once full, the cursor only tugs at it. For
     *  its first feedTime milliseconds a spiral also draws in free stars passing
     *  within feedRadius of its centre, so it fills in on its own as well. */
    feedTime: 7000,
    feedRadius: 120,
    wellCap: 40,
    /** Free stars within haloRadius of a spiral are turned about it, at up to
     *  haloSpeed pixels per frame near it, slower further out. */
    haloRadius: 300,
    haloSpeed: 1.0,
    /** Trail left by a star on a spiral: how many frames long, how opaque at
     *  its head, and how wide, in pixels. */
    trailLength: 20,
    trailAlpha: 0.35,
    trailWidth: 1.3,
    /** Held stars keep this far apart, as a multiple of their glyph sizes
     *  (1 = just touching), and how firmly a crowded pair is moved apart. */
    spacing: 1.15,
    separation: 0.35,
    /** How long a star stays on the formed spiral before it is let go, in
     *  milliseconds, plus a random spread. Its whole orbit is formTime plus
     *  this, so it always has time to be seen in place. */
    formedHold: 4000,
    holdSpread: 1500,
    /** Opacity left to free stars behind marked text, and the width of the
     *  soft edge around it, in pixels. */
    calm: 0.22,
    calmFeather: 48,
    /** How much brighter a held star is drawn, so the gathering reads. */
    heldGlow: 0.6,
    /** Milliseconds before a star can be caught again. */
    cooldown: 3000,
    /** Speed of the free drift, and the cap on a free star's speed. */
    flowSpeed: 0.85,
    maxSpeed: 2.4,
  };

  /** Resolves any CSS colour to RGB; falls back to white if it cannot be parsed. */
  function toRgb(css: string): Rgb {
    const probe = document.createElement('canvas').getContext('2d', { willReadFrequently: true });
    if (!probe) return [255, 255, 255];
    probe.fillStyle = '#fff';
    probe.fillStyle = css;
    probe.fillRect(0, 0, 1, 1);
    const d = probe.getImageData(0, 0, 1, 1).data;
    return [d[0], d[1], d[2]];
  }

  /**
   * Direction of the flow field at a point, in radians. Three slow waves that
   * drift over time: smooth enough that nearby stars move alike, varied enough
   * that they do not all end up in one place.
   */
  function flowAngle(x: number, y: number, t: number): number {
    const a =
      Math.sin(x * 0.0021 + t * 0.00011) +
      Math.cos(y * 0.0027 - t * 0.00009) +
      Math.sin((x + y) * 0.0015 + t * 0.00007);
    return a * 1.6;
  }

  function init(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    const host = canvas.parentElement;
    if (!ctx || !host) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

    /** Cap on how many are held at once, so the swarm is never emptied. */
    const MAX_HELD = 80;
    /** Base downward drift, so a freed star falls away down the page. */
    const FALL = 0.16;
    const MARGIN = 20;

    let w = 0;
    let h = 0;
    const stars: Star[] = [];
    let tones: Rgb[] = [
      [255, 255, 255],
      [255, 255, 255],
      [255, 255, 255],
    ];
    let sprites: HTMLCanvasElement[] = [];
    /** Glyph sprites, by tone then by symbol. */
    let glyphs: HTMLCanvasElement[][] = [];
    let running = false;
    let visible = true;
    let raf = 0;
    let last = 0;
    let clock = 0;
    const pointer = { x: 0, y: 0, vx: 0, vy: 0, active: false, strength: 0, moved: 0 };
    /** The point the caught stars orbit: it trails the cursor on a critically
     *  damped spring, in pixels and pixels per second. */
    const anchor = { x: 0, y: 0, vx: 0, vy: 0, ready: false };
    const wells: Well[] = [];
    /** How many free stars the field should have, set by its size. */
    let baseCount = 0;
    /** Milliseconds the cursor has been lingering, moving slower than sowSpeed. */
    let lingered = 0;

    /** A star joins an eddy. Its orbit starts where it is, so nothing jumps. */
    function catchInto(s: Star, well: Well, sy: number) {
      s.well = well;
      well.stars++;
      // Another takes its place in the field, fading in somewhere else.
      stars.push(spawn());
      s.caughtAt = Math.hypot(s.x - well.x, sy - well.y);
      s.formDur = tune.formTime + (Math.max(0, s.caughtAt - tune.spiralOuter) / tune.travelSpeed) * 1000;
      s.life = s.formDur + tune.formedHold + Math.random() * tune.holdSpread;
      s.held = s.life;
      s.age = 0;
      s.ringOffset = 0;
      s.orbit = 0;
      s.form = 0;
      // Its place on the arm: the first free one from the centre out.
      let slot = well.taken.indexOf(false);
      if (slot < 0) slot = well.taken.length - 1;
      well.taken[slot] = true;
      s.slot = slot;
      const place = armPlace(slot);
      s.slotR = place.r;
      const curl = place.angle;
      // Aim for where that place will be when it arrives, not where it is now,
      // so it travels the short way and never has to chase the spiral's turn.
      s.angle0 = Math.atan2(sy - well.y, s.x - well.x);
      const arrival = well.spin + ((tune.orbitSpeed * Math.PI * 2) / 1000) * s.formDur;
      const turn = Math.PI * 2;
      let delta = (((arrival + curl - s.angle0) % turn) + turn) % turn;
      if (delta > Math.PI) delta -= turn;
      s.angle1 = s.angle0 + delta;
      s.relTarget = s.angle1 - arrival;
    }

    /** How far the arm moves out per radian it winds: an Archimedean spiral,
     *  so the turns are evenly spaced. */
    function armPitch() {
      return (tune.spiralOuter - tune.spiralInner) / (tune.spiralTurns * Math.PI * 2);
    }

    /** The k-th place along the arm, from the centre out, spaced evenly along
     *  its length so the arm reads as one line however many stars it has. */
    function armPlace(k: number) {
      const b = armPitch();
      const turns = tune.spiralTurns * Math.PI * 2;
      // Length along the arm from its start to angle t is about inner*t + b*t*t/2.
      const length = tune.spiralInner * turns + (b * turns * turns) / 2;
      const along = ((k + 0.5) / tune.wellCap) * length;
      const angle = (-tune.spiralInner + Math.sqrt(tune.spiralInner * tune.spiralInner + 2 * b * along)) / b;
      return { r: tune.spiralInner + b * angle, angle };
    }

    /** The spiral a catch at (x, y) joins: the one there is, or a new one at (x, y). */
    function wellAt(x: number, y: number): Well {
      for (let i = wells.length - 1; i >= 0; i--) if (wells[i].stars > 0) return wells[i];
      // A new spiral goes where the cursor lingers, moved in if that is near an
      // edge: inside the part of the hero on screen, below the navigation bar,
      // and above the foot of the hero where the field fades out.
      const rect = canvas.getBoundingClientRect();
      const top = Math.max(0, -rect.top) + tune.sowTop;
      const bottom = Math.min(h * 0.6, window.innerHeight - rect.top - tune.sowInset);
      const sx = w > tune.sowInset * 2 ? Math.min(Math.max(x, tune.sowInset), w - tune.sowInset) : w / 2;
      const sy = bottom > top ? Math.min(Math.max(y, top), bottom) : (top + bottom) / 2;
      const fresh: Well = {
        x: sx,
        y: sy,
        stars: 0,
        spin: Math.random() * Math.PI * 2,
        taken: new Array(tune.wellCap).fill(false),
        age: 0,
        presence: 0,
      };
      wells.push(fresh);
      return fresh;
    }

    const swatch = document.createElement('span');
    swatch.setAttribute('aria-hidden', 'true');
    swatch.style.display = 'none';
    host.appendChild(swatch);

    const rgba = (c: Rgb, a: number) => `rgba(${c[0]},${c[1]},${c[2]},${a})`;

    /** A soft round glow, drawn once per tone and stamped for every halo. */
    function makeSprite(color: Rgb): HTMLCanvasElement {
      const size = 64;
      const sprite = document.createElement('canvas');
      sprite.width = size;
      sprite.height = size;
      const c = sprite.getContext('2d');
      if (c) {
        const g = c.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
        g.addColorStop(0, rgba(color, 0.9));
        g.addColorStop(0.25, rgba(color, 0.28));
        g.addColorStop(1, rgba(color, 0));
        c.fillStyle = g;
        c.fillRect(0, 0, size, size);
      }
      return sprite;
    }

    /** One symbol in one tone, drawn large so it stays crisp when scaled down. */
    /** The site's monospace face, read from --font-mono. */
    let glyphFamily = 'ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';

    function makeGlyph(symbol: string, color: Rgb): HTMLCanvasElement {
      const sprite = document.createElement('canvas');
      sprite.width = GLYPH_PX;
      sprite.height = GLYPH_PX;
      const c = sprite.getContext('2d');
      if (c) {
        c.font = `600 ${GLYPH_PX * 0.7}px ${glyphFamily}`;
        c.textAlign = 'center';
        c.textBaseline = 'middle';
        c.fillStyle = rgba(color, 1);
        c.fillText(symbol, GLYPH_PX / 2, GLYPH_PX / 2);
      }
      return sprite;
    }

    function readColors() {
      swatch.style.fontFamily = 'var(--font-mono)';
      glyphFamily = getComputedStyle(swatch).fontFamily || glyphFamily;
      tones = TONE_VARS.map((name) => {
        swatch.style.color = `var(${name})`;
        return toRgb(getComputedStyle(swatch).color);
      });
      sprites = tones.map(makeSprite);
      glyphs = tones.map((tone) => SYMBOLS.map((symbol) => makeGlyph(symbol, tone)));
    }

    const clamp01 = (v: number) => Math.min(Math.max(v, 0), 1);

    /** How far the hero has been scrolled past, 0 to 1. The field thins out and
     *  hurries along as it goes, so the hero dissolves into the page below. */
    function scrollFade() {
      if (reduced.matches) return 0;
      const rect = canvas.getBoundingClientRect();
      return rect.height ? clamp01(-rect.top / (rect.height * 0.75)) : 0;
    }

    /** Entrance: the far layers appear first and the near ones after, so the
     *  field opens up in depth instead of fading in all at once. 0 to 1. */
    function appear(s: Star) {
      if (reduced.matches) return 1;
      const delay = ((s.z - 0.4) / 0.6) * 700 + (s.twinkle / (Math.PI * 2)) * 250;
      const t = clamp01((clock - s.born - delay) / 900);
      return 1 - Math.pow(1 - t, 3);
    }

    function scrollShift() {
      return reduced.matches ? 0 : Math.min(window.scrollY, window.innerHeight * 1.2) * 0.06;
    }

    function spawn(): Star {
      const z = 0.4 + Math.random() * 0.6;
      const x = Math.random() * w;
      const y = Math.random() * h;
      const speed = (0.12 + Math.random() * 0.26) * z;
      const phase = (Math.random() - 0.5) * 0.9;
      const angle = flowAngle(x, y, 0) + phase;
      const roll = Math.random();
      return {
        x,
        y,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed + FALL * z,
        speed,
        phase,
        r: (12 + Math.random() * 11) * (0.55 + 0.45 * z),
        z,
        tone: roll < 0.55 ? 0 : roll < 0.88 ? 1 : 2,
        sym: Math.floor(Math.random() * SYMBOLS.length),
        halo: Math.random() < 0.06,
        twinkle: Math.random() * Math.PI * 2,
        held: 0,
        grab: 0,
        cool: 0,
        orbit: 0,
        caughtAt: 0,
        life: 0,
        slotR: 0,
        slot: -1,
        relTarget: 0,
        angle0: 0,
        angle1: 0,
        form: 0,
        formDur: 0,
        age: 0,
        ringOffset: 0,
        well: null,
        born: clock,
        retire: false,
        gone: 1,
        trail: [],
      };
    }

    /** Rectangles, in canvas pixels, of the text the field fades behind. */
    let calmZones: { l: number; t: number; r: number; b: number }[] = [];

    function measureCalm() {
      const base = canvas.getBoundingClientRect();
      calmZones = Array.from(host!.querySelectorAll<HTMLElement>('[data-particle-calm]')).map((el) => {
        const r = el.getBoundingClientRect();
        return { l: r.left - base.left, t: r.top - base.top, r: r.right - base.left, b: r.bottom - base.top };
      });
    }

    /** 1 away from the marked text, falling smoothly to `tune.calm` on it. */
    function calmAt(x: number, y: number) {
      let f = 1;
      for (const z of calmZones) {
        const dx = Math.max(z.l - x, 0, x - z.r);
        const dy = Math.max(z.t - y, 0, y - z.b);
        const t = clamp01(Math.hypot(dx, dy) / tune.calmFeather);
        f = Math.min(f, tune.calm + (1 - tune.calm) * t * t * (3 - 2 * t));
      }
      return f;
    }

    function resize() {
      const nw = canvas.clientWidth;
      const nh = canvas.clientHeight;
      if (!nw || !nh) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(nw * dpr);
      canvas.height = Math.round(nh * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      if (w && h) {
        for (const s of stars) {
          s.x *= nw / w;
          s.y *= nh / h;
        }
      }
      w = nw;
      h = nh;
      measureCalm();

      const density = finePointer.matches ? 1 : 0.55;
      const target = Math.round(Math.min(380, Math.max(90, (w * h) / 5200)) * density);
      baseCount = target;
      while (stars.length < target) stars.push(spawn());
      if (stars.length > target) stars.length = target;
    }

    function step(dt: number) {
      clock += dt;
      const k = dt / 16.67;
      pointer.strength += ((pointer.active ? 1 : 0) - pointer.strength) * Math.min(1, 0.07 * k);
      // The cursor's own velocity, smoothed, in pixels per frame.
      pointer.vx *= Math.exp(-dt / 140);
      pointer.vy *= Math.exp(-dt / 140);
      const shift = scrollShift();
      const rush = 1 + 1.2 * scrollFade();
      const collecting = pointer.strength > 0.35;
      let held = 0;
      for (const s of stars) if (s.held > 0) held++;

      const dts = dt / 1000;
      if (!pointer.active) anchor.ready = false;
      else if (!anchor.ready) {
        Object.assign(anchor, { x: pointer.x, y: pointer.y, vx: 0, vy: 0, ready: true });
      } else {
        const wa = 2 * Math.PI * tune.anchorHz;
        const decay = Math.exp(-wa * dts);
        const ex = anchor.x - pointer.x;
        const ey = anchor.y - pointer.y;
        anchor.x = pointer.x + (ex + (anchor.vx + wa * ex) * dts) * decay;
        anchor.y = pointer.y + (ey + (anchor.vy + wa * ey) * dts) * decay;
        anchor.vx = (anchor.vx - wa * (anchor.vx + wa * ex) * dts) * decay;
        anchor.vy = (anchor.vy - wa * (anchor.vy + wa * ey) * dts) * decay;
      }

      lingered = anchor.ready && Math.hypot(anchor.vx, anchor.vy) < tune.sowSpeed ? lingered + dt : 0;
      const sowing = collecting && lingered > tune.sowDelay;
      for (const well of wells) {
        well.spin += ((tune.orbitSpeed * Math.PI * 2) / 1000) * dt;
        well.age += dt;
        well.presence += ((well.stars > 0 ? 1 : 0) - well.presence) * (1 - Math.exp(-dt / 900));
      }

      for (const s of stars) {
        const sy = s.y - shift * s.z;
        const d = Math.hypot(s.x - pointer.x, sy - pointer.y);

        if (s.held <= 0 && s.cool <= 0 && held < MAX_HELD) {
          // Caught by the cursor where it lingers, or drawn in by a young spiral
          // it passes close to.
          let well: Well | null = null;
          if (sowing && d < tune.catchRadius && !wells.some((well) => well.stars >= tune.wellCap)) {
            well = wellAt(anchor.x, anchor.y);
          }
          if (!well) {
            for (const candidate of wells) {
              if (
                candidate.stars > 0 &&
                candidate.age < tune.feedTime &&
                candidate.stars < tune.wellCap &&
                Math.hypot(s.x - candidate.x, sy - candidate.y) < tune.feedRadius
              ) {
                well = candidate;
                break;
              }
            }
          }
          if (well) {
            catchInto(s, well, sy);
            held++;
          }
        }

        // How hard the cursor is tugging at it, 0 to tune.tug.
        let tug = 0;
        if (s.well && s.grab > 0) {
          const q = clamp01(1 - Math.hypot(s.x - anchor.x, sy - anchor.y) / tune.tugRadius);
          tug = tune.tug * q * q * (3 - 2 * q) * pointer.strength;
        }

        if (s.held > 0) {
          s.held -= dt;
          if (s.held <= 0) {
            s.cool = tune.cooldown;
            if (s.well && s.slot >= 0) s.well.taken[s.slot] = false;
            s.slot = -1;
            if (stars.length - held > baseCount) s.retire = true;
          }
        } else if (s.cool > 0) {
          s.cool -= dt;
        }

        if (s.retire) s.gone = Math.max(0, s.gone - dt / 1400);

        // The orbit's pull comes on and goes off gradually.
        const holding = s.held > 0 ? 1 : 0;
        s.grab += (holding - s.grab) * (1 - Math.exp(-dt / (holding ? tune.gripIn : tune.gripOut)));
        if (s.grab < 0.001) s.grab = 0;

        if (s.grab > 0 && s.well) {
          // Forming: it swirls from where it was caught to its place on an arm,
          // ahead of the spiral's own turn. Formed: it sits on its arm and the
          // spiral turns it. Let go: the spiral opens out and carries it off.
          s.age += dt;
          const f = clamp01(s.age / s.formDur);
          const forming = f * f * f * (f * (f * 6 - 15) + 10);
          s.form = forming;
          const breath = 1 + tune.breathe * Math.sin(clock * 0.0015 + s.twinkle);
          const out = clamp01((s.age - s.life) / tune.gripOut);
          const opening = 1 - (1 - out) * (1 - out);
          s.ringOffset *= Math.exp(-dt / 1500);
          const radius = Math.max(
            4,
            s.caughtAt +
              (s.slotR * breath - s.caughtAt) * forming +
              (tune.spiralOuter * tune.spiralOut - s.slotR) * opening +
              s.ringOffset * (1 - forming)
          );
          // Forming, it travels from where it was caught towards where its place
          // will be on arrival; formed, the spiral turns it.
          const base = forming < 1 ? s.angle0 + (s.angle1 - s.angle0) * forming : s.well.spin + s.relTarget;
          // Crowding only nudges it while it forms: on the arm, its place is
          // already spaced from its neighbours, and a nudge would take it off.
          const angle = base + s.orbit * (1 - forming);
          const cos = Math.cos(angle);
          const sin = Math.sin(angle);
          // The cursor's tug bends it towards a small ring round the cursor.
          const near = tune.spiralOuter * 0.4;
          const tx = s.well.x + cos * radius + (anchor.x + cos * near - (s.well.x + cos * radius)) * tug;
          const ty = s.well.y + sin * radius + (anchor.y + sin * near - (s.well.y + sin * radius)) * tug;
          // A critically damped spring towards it, as strong as the grip: it
          // arrives without overshooting and its speed never jumps. This is the
          // spring's exact solution over the frame, so a long frame on a slow
          // machine cannot make it overshoot either.
          const omega = 2 * Math.PI * tune.followHz * s.grab;
          const decay = Math.exp(-omega * dts);
          const vxs = s.vx * 60;
          const vys = s.vy * 60;
          s.vx = ((vxs - omega * (vxs + omega * (s.x - tx)) * dts) * decay) / 60;
          s.vy = ((vys - omega * (vys + omega * (sy - ty)) * dts) * decay) / 60;
        }

        // Free drift: the flow field, plus a slow fall down the page, taking
        // over as the grip lets go.
        const angle = flowAngle(s.x, s.y, clock) + s.phase;
        let freeVx = Math.cos(angle) * s.speed * rush * tune.flowSpeed;
        let freeVy = (Math.sin(angle) * s.speed + FALL * s.z) * rush * tune.flowSpeed;
        // Near a spiral the field turns slowly about it, the way it turns.
        for (const well of wells) {
          const hx = s.x - well.x;
          const hy = sy - well.y;
          const hd = Math.hypot(hx, hy);
          if (hd < 1 || hd > tune.haloRadius) continue;
          const q = 1 - hd / tune.haloRadius;
          const swirl = tune.haloSpeed * q * well.presence * (0.6 + 0.4 * s.z);
          freeVx += (-hy / hd) * swirl;
          freeVy += (hx / hd) * swirl;
        }
        s.vx += (freeVx - s.vx) * 0.035 * (1 - s.grab) * k;
        s.vy += (freeVy - s.vy) * 0.035 * (1 - s.grab) * k;

        // A soft speed limit: anything faster is eased back, not clipped.
        const speed = Math.hypot(s.vx, s.vy);
        const cap = tune.maxSpeed + (tune.heldMaxSpeed - tune.maxSpeed) * s.grab;
        if (speed > cap) {
          const ease = 1 - (1 - cap / speed) * Math.min(1, tune.brake * k);
          s.vx *= ease;
          s.vy *= ease;
        }
        s.x += s.vx * k;
        s.y += s.vy * k;

        // Wrap round the edges, but never while the cursor has it.
        if (s.grab < 0.05) {
          if (s.x < -MARGIN) s.x = w + MARGIN;
          else if (s.x > w + MARGIN) s.x = -MARGIN;
          if (s.y < -MARGIN) s.y = h + MARGIN;
          else if (s.y > h + MARGIN) s.y = -MARGIN;
        }
      }

      separateHeld(shift, k);

      // An eddy lasts as long as it has stars; a star let go leaves it once
      // its grip has faded.
      for (const well of wells) well.stars = 0;
      for (const s of stars) {
        if (!s.well) continue;
        if (s.held <= 0 && s.grab === 0) s.well = null;
        else s.well.stars++;
      }
      for (let i = wells.length - 1; i >= 0; i--) {
        if (wells[i].stars === 0 && wells[i].presence < 0.02) wells.splice(i, 1);
      }
      for (let i = stars.length - 1; i >= 0; i--) if (stars[i].gone <= 0) stars.splice(i, 1);

      // Trails: a star on a spiral records where it has been; once let go its
      // trail shortens until it is gone.
      for (const s of stars) {
        if (s.grab > 0.05 && s.well) {
          s.trail.push(s.x, s.y - shift * s.z);
          if (s.trail.length > tune.trailLength * 2) s.trail.splice(0, 2);
        } else if (s.trail.length) {
          s.trail.splice(0, 2);
        }
      }
    }

    /**
     * Keeps held stars from piling up on one another. Pushing their positions
     * apart would only fight the orbit and make them tremble, so a crowded pair
     * is moved apart in the orbit itself: along it, by turning their angles
     * away from each other, and across it, by easing one a little further out
     * and the other a little further in. They spread round the cursor and stay
     * spread; the offset across the orbit fades once they have room.
     */
    function separateHeld(shift: number, k: number) {
      if (tune.separation <= 0) return;
      const held = stars.filter((s) => s.held > 0);
      for (let a = 0; a < held.length; a++) {
        const p = held[a];
        const py = p.y - shift * p.z;
        for (let b = a + 1; b < held.length; b++) {
          const q = held[b];
          const qy = q.y - shift * q.z;
          let ux = q.x - p.x;
          let uy = qy - py;
          let dist = Math.hypot(ux, uy);
          const min = (p.r + q.r) * 0.5 * tune.spacing;
          if (dist >= min) continue;
          if (dist < 0.01) {
            // Exactly on top of each other: any direction will do.
            const angle = (a * 7.3 + b * 3.1) % (Math.PI * 2);
            ux = Math.cos(angle);
            uy = Math.sin(angle);
            dist = 0.01;
          } else {
            ux /= dist;
            uy /= dist;
          }
          const push = (min - dist) * 0.5 * tune.separation * k;
          nudge(p, p.x, py, -ux * push, -uy * push);
          nudge(q, q.x, qy, ux * push, uy * push);
        }
      }
    }

    /** Moves a held star's place on its orbit by (mx, my) pixels. */
    function nudge(s: Star, x: number, y: number, mx: number, my: number) {
      if (!s.well) return;
      const rx = x - s.well.x;
      const ry = y - s.well.y;
      const r = Math.hypot(rx, ry) || 1;
      const radial = (mx * rx + my * ry) / r;
      const along = (-mx * ry + my * rx) / r;
      s.orbit += along / Math.max(r, 10);
      const room = tune.spiralOuter * 0.5;
      s.ringOffset = Math.max(-room, Math.min(room, s.ringOffset + radial));
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);
      // Nearer stars shift more as the page scrolls, which is what gives the
      // layers their depth. Clamped so a long scroll cannot fling them away.
      const shift = scrollShift();
      const fade = scrollFade();
      const keep = 1 - fade * fade * (3 - 2 * fade);
      if (keep <= 0) return;

      // A faint glow where the cursor is, so the swarm has something to part around.
      if (pointer.strength > 0.01) {
        const s = pointer.strength;
        const radius = tune.catchRadius;
        const glow = ctx!.createRadialGradient(pointer.x, pointer.y, 0, pointer.x, pointer.y, radius);
        glow.addColorStop(0, rgba(tones[1], 0.12 * s * keep));
        glow.addColorStop(1, rgba(tones[1], 0));
        ctx!.fillStyle = glow;
        ctx!.fillRect(pointer.x - radius, pointer.y - radius, radius * 2, radius * 2);
      }


      // Trails, under the stars: each segment fainter the older it is.
      ctx!.lineCap = 'round';
      for (const s of stars) {
        const points = s.trail.length / 2;
        if (points < 2) continue;
        ctx!.strokeStyle = rgba(tones[s.tone], 1);
        ctx!.lineWidth = tune.trailWidth * (0.6 + 0.4 * s.z);
        for (let i = 1; i < points; i++) {
          ctx!.globalAlpha = tune.trailAlpha * (i / points) * keep * s.gone;
          ctx!.beginPath();
          ctx!.moveTo(s.trail[(i - 1) * 2], s.trail[(i - 1) * 2 + 1]);
          ctx!.lineTo(s.trail[i * 2], s.trail[i * 2 + 1]);
          ctx!.stroke();
        }
      }
      ctx!.globalAlpha = 1;

      for (const s of stars) {
        const y = s.y - shift * s.z;
        const tw = reduced.matches ? 1 : 0.85 + 0.15 * Math.sin(clock * 0.002 + s.twinkle);
        // Held stars keep their brightness, so the cloud reads wherever the cursor is.
        const quiet = calmAt(s.x, y);
        const shown = appear(s) * keep * (quiet + (1 - quiet) * s.grab) * s.gone;
        if (shown <= 0) continue;
        const alpha = Math.min(1, (0.45 + 0.55 * s.z) * tw * (1 + tune.heldGlow * s.grab * (tune.formGlow + (1 - tune.formGlow) * s.form))) * shown;
        const r = s.r * (0.75 + 0.25 * appear(s));
        if (s.halo) {
          const size = r * 2.6;
          ctx!.globalAlpha = 0.55 * s.z * tw * shown;
          ctx!.drawImage(sprites[s.tone], s.x - size / 2, y - size / 2, size, size);
        }
        ctx!.globalAlpha = alpha;
        ctx!.drawImage(glyphs[s.tone][s.sym], s.x - r / 2, y - r / 2, r, r);
      }
      ctx!.globalAlpha = 1;
    }

    function frame(now: number) {
      raf = 0;
      if (!running) return;
      const dt = Math.min(now - last, 50);
      last = now;
      step(dt);
      draw();
      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (running) return;
      running = true;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      running = false;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    function update() {
      if (visible && !document.hidden && !reduced.matches) start();
      else stop();
      if (!running) draw();
    }

    function onMove(e: PointerEvent) {
      if (reduced.matches || e.pointerType === 'touch') return;
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const now = performance.now();
      if (pointer.active && pointer.moved) {
        const dt = Math.max(8, now - pointer.moved);
        // Pixels per frame, blended in so a single jittery event cannot jerk the swarm.
        pointer.vx += ((x - pointer.x) / dt) * 16.67 * 0.4;
        pointer.vy += ((y - pointer.y) / dt) * 16.67 * 0.4;
        const speed = Math.hypot(pointer.vx, pointer.vy);
        if (speed > 24) {
          pointer.vx *= 24 / speed;
          pointer.vy *= 24 / speed;
        }
      }
      pointer.x = x;
      pointer.y = y;
      pointer.moved = now;
      pointer.active = true;
    }

    readColors();
    resize();
    update();
    // Once the monospace face has loaded, redraw the glyphs in it, and measure
    // the text again: the heading settles into place as the page opens.
    document.fonts
      ?.load(`600 34px ${glyphFamily}`)
      .then(() => readColors())
      .catch(() => {});
    document.fonts?.ready.then(measureCalm);
    window.setTimeout(measureCalm, 1500);

    new ResizeObserver(() => {
      resize();
      if (!running) draw();
    }).observe(canvas);
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      update();
    }).observe(canvas);
    new MutationObserver(() => {
      readColors();
      if (!running) draw();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });

    document.addEventListener('visibilitychange', update);
    reduced.addEventListener('change', update);
    host.addEventListener('pointermove', onMove);
    host.addEventListener('pointerleave', () => {
      pointer.active = false;
      pointer.moved = 0;
    });
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.particle-field').forEach(init);
</script>
