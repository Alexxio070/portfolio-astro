---
import { cn } from '@/lib/cn';
import { t, getLocaleFromPath } from '@/i18n';

interface Props {
  class?: string;
  /** `pill` is the round, bordered button of the navigation bar; the default
   *  is the plain button used inside the mobile settings panel. */
  variant?: 'plain' | 'pill';
}

const { class: className, variant = 'plain' } = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
// The script below rebuilds these on every click, so it needs the
// translated templates rather than the rendered strings. Same approach as
// ThemeModeDropdown: hand them over as data attributes and let the script
// substitute {mode}.
const labelTemplate = t('common.themeMode', locale, { mode: '{mode}' });
const titleTemplate = t('common.themeModeTitle', locale, { mode: '{mode}' });
const modeNames = { light: t('theme.light', locale), dark: t('theme.dark', locale) };
---

<!-- Colour-mode switch. Each click flips between light and dark. The first
     visit follows the visitor's system setting (resolved by the inline
     bootstrap in BaseLayout); from then on the choice is theirs. The visible
     icon is driven by <html data-theme-mode="…"> so it stays in sync with
     that bootstrap (no flash of the wrong icon). -->
<button
  type="button"
  id="theme-toggle"
  class={cn(
    'theme-toggle inline-flex items-center justify-center',
    variant === 'pill'
      ? 'ttg-trigger rounded-full border border-border-strong p-1.5 text-foreground-muted hover:text-foreground hover:bg-secondary'
      : 'rounded-md p-2 text-muted-foreground hover:text-foreground hover:bg-secondary',
    'transition-colors duration-(--transition-fast)',
    'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2',
    className
  )}
  aria-label={labelTemplate.replace('{mode}', modeNames.dark)}
  title={titleTemplate.replace('{mode}', modeNames.dark)}
  data-i18n-label={labelTemplate}
  data-i18n-title={titleTemplate}
  data-name-light={modeNames.light}
  data-name-dark={modeNames.dark}
>
  <!-- Sun icon — shown when mode === 'light' -->
  <svg
    class="theme-toggle__icon theme-toggle__icon--light h-5 w-5"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
    />
  </svg>

  <!-- Moon icon — shown when mode === 'dark' -->
  <svg
    class="theme-toggle__icon theme-toggle__icon--dark h-5 w-5"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
    />
  </svg>
</button>

<style>
  /* Show exactly one icon based on the saved colour-mode. The bootstrap
     sets data-theme-mode synchronously before paint, so the right icon is
     visible from frame 0 (no flash). */
  .theme-toggle__icon { display: none; }
  /* The round bar button is smaller than the plain one. */
  .theme-toggle.ttg-trigger .theme-toggle__icon { width: 1rem; height: 1rem; }
  :global(html[data-theme-mode='light'])  .theme-toggle .theme-toggle__icon--light,
  :global(html[data-theme-mode='dark'])   .theme-toggle .theme-toggle__icon--dark {
    display: block;
  }
</style>

<script>
  type Mode = 'light' | 'dark';

  /** The mode the bootstrap resolved: it sets data-theme-mode before paint. */
  function readMode(): Mode {
    return document.documentElement.getAttribute('data-theme-mode') === 'light' ? 'light' : 'dark';
  }

  function applyMode(mode: Mode): void {
    const root = document.documentElement;
    root.setAttribute('data-theme-mode', mode);
    root.classList.toggle('dark', mode === 'dark');
  }

  function syncLabel(button: HTMLElement, mode: Mode): void {
    const label = button.dataset.i18nLabel ?? 'Theme: {mode}';
    const title = button.dataset.i18nTitle ?? 'Theme: {mode} (click to switch)';
    const name = (mode === 'light' ? button.dataset.nameLight : button.dataset.nameDark) ?? mode;
    button.setAttribute('aria-label', label.replace('{mode}', name));
    button.setAttribute('title', title.replace('{mode}', name));
  }

  function initThemeToggle(): void {
    // Every switch on the page (bar and mobile panel) shares one mode.
    document.querySelectorAll<HTMLElement>('.theme-toggle').forEach((toggle) => {
      if (toggle.dataset.themeInit) return;
      toggle.dataset.themeInit = 'true';

      syncLabel(toggle, readMode());

      toggle.addEventListener('click', () => {
        const next: Mode = readMode() === 'dark' ? 'light' : 'dark';
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* private mode */
        }
        const swap = () => {
          applyMode(next);
          document.querySelectorAll<HTMLElement>('.theme-toggle').forEach((other) => syncLabel(other, next));
        };
        // Where the browser can crossfade the whole page, use it, so the
        // change is a dissolve rather than a flash. Elsewhere, or with reduced
        // motion, the mode simply changes.
        const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!calm && typeof document.startViewTransition === 'function') document.startViewTransition(swap);
        else swap();
      });
    });
  }

  // Run on initial load and after every view-transition swap
  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
