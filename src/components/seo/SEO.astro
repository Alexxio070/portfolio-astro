---
import siteConfig from '@/config/site.config';
import {
  isEnabled as i18nIsEnabled,
  getLocales,
  defaultLocale,
  swapLocaleInPath,
} from '@/i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title,
  description = siteConfig.description,
  image,
  imageAlt,
  noindex = false,
  nofollow = false,
} = Astro.props;

// The <title> tag carries the site name so the brand shows in search results.
// Social cards do not: Facebook, LinkedIn and X render `og:site_name` as their
// own line above the title, so repeating it in `og:title` shows the name twice
// and spends ~16 characters of a box that truncates around 60-70.
const pageTitle = title ? `${title} — ${siteConfig.name}` : siteConfig.name;
const socialTitle = title || siteConfig.name;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Process image - fall back to the static default OG image
let ogImage: string;
if (image) {
  ogImage = image.startsWith('http') ? image : new URL(image, Astro.site).toString();
} else {
  ogImage = new URL(siteConfig.ogImage, Astro.site).toString();
}

const robotsContent = [noindex ? 'noindex' : 'index', nofollow ? 'nofollow' : 'follow'].join(', ');

// Normalize BCP-47 locale (e.g. "en") to OG language_TERRITORY format (e.g. "en_US")
const localeMap: Record<string, string> = {
  en: 'en_US', fr: 'fr_FR', de: 'de_DE', es: 'es_ES', it: 'it_IT',
  pt: 'pt_BR', nl: 'nl_NL', ja: 'ja_JP', ko: 'ko_KR', zh: 'zh_CN',
  ru: 'ru_RU', ar: 'ar_SA', hi: 'hi_IN', pl: 'pl_PL', sv: 'sv_SE',
};
const rawLocale = Astro.currentLocale || 'en_US';
const locale = rawLocale.includes('_') || rawLocale.includes('-')
  ? rawLocale.replace('-', '_')
  : (localeMap[rawLocale] || `${rawLocale}_${rawLocale.toUpperCase()}`);

// Determine OG image MIME type from file extension
const extToMime: Record<string, string> = {
  '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg',
  '.webp': 'image/webp', '.gif': 'image/gif', '.svg': 'image/svg+xml',
};
function getImageType(url: string): string | undefined {
  const ext = url.match(/(\.\w+)(?:\?|$)/)?.[1]?.toLowerCase();
  return ext ? extToMime[ext] : undefined;
}
const ogImageType = getImageType(ogImage);

// hreflang alternates: only emitted when i18n is enabled with more than one
// locale. `x-default` points at the default-locale URL, per Google's
// recommendation. Each alternate is the same page with the locale segment of
// the path swapped, which is right while every language shares its slug.
// A page that asks not to be indexed has no alternates worth declaring (the
// 404 has no per-language version at all).
const i18nOn = i18nIsEnabled() && !noindex;
// The built URLs end in a slash (`/es/`) and the canonical tag says so; the
// swapped path must follow, or the alternate names a different URL than the
// page declares as its own.
const keepSlash = Astro.url.pathname.endsWith('/');
const withSlash = (path: string) => (keepSlash && !path.endsWith('/') ? `${path}/` : path);
const alternateFor = (loc: string) => withSlash(swapLocaleInPath(Astro.url.pathname, loc));
const hreflangAlternates = i18nOn
  ? getLocales().map((loc) => ({
      hreflang: loc,
      href: new URL(alternateFor(loc), Astro.site).toString(),
    }))
  : [];
const xDefaultHref = i18nOn ? new URL(alternateFor(defaultLocale), Astro.site).toString() : null;
---

{/* Primary Meta Tags */}
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL.toString()} />
<meta name="robots" content={robotsContent} />

{/* hreflang alternates (only when i18n is enabled with multiple locales) */}
{hreflangAlternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
{xDefaultHref && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}

{/* Open Graph */}
<meta property="og:title" content={socialTitle} />
<meta property="og:type" content="website" />
<meta property="og:image" content={ogImage} />
<meta property="og:url" content={canonicalURL.toString()} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={locale} />
<meta property="og:image:alt" content={imageAlt || socialTitle} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{ogImageType && <meta property="og:image:type" content={ogImageType} />}

{/* Twitter Card */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{siteConfig.twitter?.site && <meta name="twitter:site" content={siteConfig.twitter.site} />}
{siteConfig.twitter?.creator && <meta name="twitter:creator" content={siteConfig.twitter.creator} />}

{/* Verification */}
{siteConfig.verification?.google && <meta name="google-site-verification" content={siteConfig.verification.google} />}
{siteConfig.verification?.bing && <meta name="msvalidate.01" content={siteConfig.verification.bing} />}
