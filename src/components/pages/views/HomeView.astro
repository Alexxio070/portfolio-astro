---
/**
 * HomeView — the single-page body: hero, projects and contact.
 *
 * Shared by the default-locale route (`/`) and the locale-prefixed route
 * (`/<locale>`). Copy is read from `pages.home.*` via `t()` / `tData()`.
 * Projects are loaded for the active locale and fall back to the default
 * locale so the section is never empty on a locale that hasn't translated
 * its projects yet. Each section carries an id (`home`, `projects`,
 * `contact`) so the page can be navigated with anchors.
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Hero } from '@/components/hero';
import Button from '@/components/ui/form/Button/Button.astro';
import SectionTitle from '@/components/pages/SectionTitle.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { accordionItemVariants, accordionTriggerVariants } from '@/components/ui/overlay/Accordion/accordion.variants';
import { cn } from '@/lib/cn';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import siteConfig from '@/config/site.config';
import { getVisibleProjects } from '@/lib/projects';
import { resolveSocialLinks } from '@/lib/utils';
import { t, tData, defaultLocale } from '@/i18n';

interface Props {
  /** Locale whose copy and content this page renders. Defaults to the site default. */
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;

let projectItems = await getVisibleProjects(locale);
if (projectItems.length === 0 && locale !== defaultLocale) {
  projectItems = await getVisibleProjects(defaultLocale);
}
const shownProjects = projectItems.sort((a, b) => a.data.order - b.data.order).slice(0, 4);

const hero = tData<{
  titleLine1: string;
  titleLine2: string;
  description: string;
  email: string;
}>('pages.home.hero', locale)!;
// The last word travels with the blinking caret, so the caret never wraps onto a
// line of its own.
const descriptionWords = hero.description.split(' ');
const descriptionTail = descriptionWords.pop() ?? '';
const descriptionHead = descriptionWords.join(' ');
const about = tData<{ badge: string; heading: string; items: { icon: string; title: string; points: string[] }[] }>(
  'pages.home.about',
  locale
)!;
// Two columns up to six items (three rows of two); a seventh item opens a
// third column. Items are entries of `pages.home.about.items` in the locale files.
const aboutColumns = about.items.length > 6 ? 'md:grid-cols-3' : 'md:grid-cols-2';
const consoleGreeting = t('pages.home.console.greeting', locale);
const projects = tData<{ heading: string; lead: string }>('pages.home.projects', locale)!;
const contact = tData<{ badge: string; heading: string; description: string; cta: string; subject: string }>(
  'pages.home.contact',
  locale
)!;

const socialLinks = resolveSocialLinks(siteConfig.socialLinks).filter((l) => ['github', 'linkedin'].includes(l.key));
// Gmail's compose window rather than a `mailto:`, which needs a mail program
// set up on the visitor's machine and does nothing at all when there is none.
// `Button` spots the external URL and opens it in a new tab by itself. The
// address is also printed in the contact card, for anyone not on Gmail.
const mailto = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(siteConfig.email)}&su=${encodeURIComponent(contact.subject)}`;
---

<LandingLayout
  title={t('pages.home.meta.title', locale)}
  description={t('pages.home.meta.description', locale)}
  includePersonSchema
>
  <div class="home-split">
  {/* Home */}
  {/* data-bar-color: Safari on iOS tints its bottom toolbar from the BODY's
       background. This hero is dark in both colour modes, so the theme script
       paints the body this colour while the hero covers that edge. Same value
       as --bar-color in global.css. See `paintBody` in BaseLayout.astro. */}
  <Hero
    id="home"
    layout="split"
    size="xl"
    class="hero-dark-gradient"
    fullHeight
    data-header-flip-anchor
    data-bar-color="#000"
    data-cursor-calm
  >
    <h1 slot="title" class="hero-name !text-[clamp(2.25rem,12vw,3rem)] sm:!text-5xl md:!text-6xl lg:!text-7xl xl:!text-[clamp(2.75rem,3.4vw,4.25rem)] text-left">
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor]">{hero.titleLine1}</span><br />
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor]">{hero.titleLine2}</span>
    </h1>

    <Fragment slot="actions">
      <div class="hero-actions flex gap-3">
        {socialLinks.map((link) => (
          <Button icon size="lg" variant="outline" href={link.href} aria-label={link.label}>
            <Icon name={link.icon} size="md" />
          </Button>
        ))}
        <Button icon size="lg" variant="outline" href={mailto} aria-label={hero.email}>
          <Icon name="mail" size="md" />
        </Button>
      </div>
    </Fragment>

    <p slot="aside" class="text-lg md:text-xl leading-relaxed text-foreground-muted text-balance">
      {descriptionHead}{' '}<span class="whitespace-nowrap">{descriptionTail}<span class="hero-caret" aria-hidden="true"></span></span>
    </p>
  </Hero>

  <div class="home-content">
  {/* About */}
  <section id="about" class="relative z-10 py-[var(--space-section-md)] bg-[color-mix(in_oklch,var(--color-brand-500)_7%,var(--color-background-secondary))] border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col gap-4" data-reveal>
        <SectionTitle title={about.heading} class="font-display text-3xl md:text-4xl xl:text-5xl font-bold text-foreground" />
      </div>

      {/* items-start: each panel grows to fit its own content and never
           stretches its neighbour. `name` makes the <details> exclusive, so
           opening one closes the open one, and clicking an open panel closes it. */}
      <div class={cn('grid grid-cols-1 items-start gap-4', aboutColumns)}>
        {about.items.map((item, i) => (
          <details
            name="about-panels"
            class={cn(accordionItemVariants({ variant: 'card' }), 'about-panel mb-0 rounded-2xl bg-background')}
            data-reveal
            data-reveal-delay={i % 2 || undefined}
          >
            <summary
              class={cn(
                accordionTriggerVariants({ size: 'lg' }),
                'cursor-pointer list-none gap-3 [&::-webkit-details-marker]:hidden'
              )}
            >
              <span class="flex min-w-0 items-center gap-3">
                <Icon name={item.icon} class="text-brand-500" />
                <span class="truncate">{item.title}</span>
              </span>
              <Icon name="chevron-down" size="sm" class="about-chevron text-foreground-muted" />
            </summary>
            <ul class="list-disc space-y-2 pb-4 pl-9 text-foreground-muted leading-relaxed">
              {item.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* Projects */}
  <section id="projects" class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col gap-4" data-reveal>
        <SectionTitle title={projects.heading} class="font-display text-3xl md:text-4xl xl:text-5xl font-bold text-foreground" />
        <p class="text-lg text-foreground-muted max-w-2xl">
          {projects.lead}
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {shownProjects.map((project, i) => (
          <ProjectCard project={project} index={i} />
        ))}
      </div>
    </div>
  </section>

  {/* Contact */}
  <section id="contact" class="relative z-10 flex min-h-[80svh] items-center py-[var(--space-section-md)] bg-[color-mix(in_oklch,var(--color-brand-500)_7%,var(--color-background-secondary))] border-t border-border">
    <div class="mx-auto w-full max-w-6xl px-6 grid gap-8 lg:grid-cols-2 lg:items-center">
      <div class="flex flex-col gap-4" data-reveal>
        <SectionTitle title={contact.heading} class="font-display text-3xl md:text-4xl xl:text-5xl font-bold text-foreground" />
        <p class="text-lg text-foreground-muted max-w-xl">
          {contact.description}
        </p>
      </div>
      <Card variant="elevated" padding="md" class="contact-card flex w-full max-w-sm flex-col items-center gap-4 text-center lg:justify-self-end" data-reveal data-reveal-delay="1">
        <p class="text-sm text-foreground-muted">{siteConfig.email}</p>
        <Button size="lg" href={mailto}>
          <Icon name="mail" size="sm" />
          {contact.cta}
        </Button>
      </Card>
    </div>
  </section>
  </div>
  </div>

<style is:global>
  /* ── Side-panel layout, from xl (1280px) up ───────────────────────────────
     The hero stops being a banner above the page and becomes a panel pinned to
     the left for the whole scroll: name, introduction and links. The sections
     scroll beside it. Below xl nothing here applies and the page is the single
     column it always was. */
  @media (min-width: 1280px) {
    .home-split {
      display: grid;
      grid-template-columns: clamp(380px, 28vw, 540px) minmax(0, 1fr);
      align-items: start;
    }
    .home-split > section.hero-dark-gradient {
      position: sticky;
      top: 0;
      height: 100svh;
      min-height: 0;
      justify-content: flex-start;
      padding: clamp(5rem, 14vh, 9rem) clamp(2rem, 3vw, 4rem) 0;
    }
    .home-split > section.hero-dark-gradient > div.grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: none;
      margin: 0;
      padding: 0;
      align-items: start;
      gap: 1.75rem;
    }
    .hero-dark-gradient .hero-title-slot + div {
      max-width: none;
    }
    /* The panel reads name, introduction, links. The hero builds a content
       column (name and links) and a separate aside (the introduction), so the
       column steps aside and its pieces are ordered with the aside between. */
    .home-split > section.hero-dark-gradient > div.grid > div.animate-hero-stagger {
      display: contents;
    }
    .home-split > section.hero-dark-gradient .hero-title-slot {
      order: 1;
      margin-bottom: 0;
    }
    .home-split > section.hero-dark-gradient > div.grid > div:not(.animate-hero-stagger) {
      order: 2;
    }
    .home-split > section.hero-dark-gradient div:has(> .hero-actions) {
      order: 3;
    }
    .home-split > section.hero-dark-gradient .text-lg {
      font-size: 1.05rem;
    }
    /* The sections sit in the right-hand column, centred in it, on the page's
       own background rather than as full-width bands. */
    .home-content > section {
      background: transparent;
      min-height: 0;
    }
    .home-content > section > div {
      max-width: 64rem;
      margin-inline: auto;
      padding-inline: clamp(2rem, 4vw, 5rem);
    }
    .home-content > section#contact {
      min-height: 70svh;
    }
    /* The larger title (a 14-character monospace path) is wider than half the
       column, so the contact block stacks: title and text, then the card. */
    .home-content > section#contact > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .home-content > section#contact .contact-card {
      justify-self: start;
    }

    /* A grid of dots behind the sections, so the plain page has some depth.
       Two layers: faint dots everywhere, and the same dots in the theme's
       colour showing only near the cursor, where --da (how much, 0 to 1)
       and --dx, --dy (where) are set from the script below. The sections sit
       above it (z-index 10) and their cards are opaque, so it only shows in
       the gaps. */
    .home-content {
      position: relative;
      isolation: isolate;
      --dot-gap: 30px;
      --dx: -999px;
      --dy: -999px;
      --da: 0;
    }
    .home-content::before,
    .home-content::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-size: var(--dot-gap) var(--dot-gap);
      background-position: calc(var(--dot-gap) / 2) calc(var(--dot-gap) / 2);
    }
    .home-content::before {
      background-image: radial-gradient(
        circle at center,
        color-mix(in oklch, var(--color-foreground) 16%, transparent) 1.1px,
        transparent 1.6px
      );
      /* Fades out towards the panel on the left. */
      -webkit-mask-image: linear-gradient(to right, transparent 0, black 140px);
      mask-image: linear-gradient(to right, transparent 0, black 140px);
    }
    .home-content::after {
      background-image: radial-gradient(
        circle at center,
        color-mix(in oklch, var(--color-brand-400) 85%, transparent) 1.4px,
        transparent 2px
      );
      -webkit-mask-image: radial-gradient(circle 240px at var(--dx) var(--dy), rgb(0 0 0 / var(--da)) 0%, transparent 100%);
      mask-image: radial-gradient(circle 240px at var(--dx) var(--dy), rgb(0 0 0 / var(--da)) 0%, transparent 100%);
    }
  }

  .about-panel[open] .about-chevron {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .about-chevron {
      transition: transform 200ms ease;
    }
  }

  /* Widen the homepage hero description from md upward so the paragraph
     reads on two lines instead of three on landscape phones, tablets,
     and all laptop/desktop sizes. Scoped via the unique
     .hero-dark-gradient class so other heroes keep the default
     max-w-xl reading measure. */
  @media (min-width: 768px) {
    .hero-dark-gradient .hero-title-slot + div {
      max-width: 48rem;
    }
  }

  /* With nothing floored to the foot of the hero, its content would sit at the
     top of the full-height section. A flex column centres it in the height. */
  section.hero-dark-gradient {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  section.hero-dark-gradient > div.grid {
    width: 100%;
  }

  /* ── Hero details ──────────────────────────────────────────────────────────
     Small, quiet touches rather than a show: a terminal caret after the
     subtitle, a light that follows the cursor over the name, and buttons that
     answer the pointer. Everything is gated on motion preference below. */

  /* Terminal caret: a block that blinks after the last word. */
  .hero-caret {
    display: inline-block;
    width: 0.42em;
    height: 0.95em;
    margin-left: 0.2em;
    vertical-align: text-bottom;
    background: var(--color-brand-400);
    border-radius: 1px;
    opacity: 0.7;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-caret {
      animation: hero-caret-blink 1.1s steps(1, end) 1.6s infinite;
    }
  }
  @keyframes hero-caret-blink {
    0%, 55% { opacity: 0.7; }
    56%, 100% { opacity: 0; }
  }

  /* Light over the name. The text keeps its own colour; a soft brand-coloured
     glow is clipped to the letters and follows the cursor. --ms is how present
     it is (0 to 1), set from the script below; at 0 the name is plain. */
  html:is(.dark, :not(.dark)) .hero-dark-gradient h1.hero-name > span {
    --mx: -999px;
    --my: -999px;
    --ms: 0;
    background-image:
      radial-gradient(
        circle 150px at var(--mx) var(--my),
        color-mix(in oklch, var(--color-brand-300) calc(var(--ms) * 100%), transparent) 0%,
        transparent 100%
      ),
      linear-gradient(currentColor, currentColor);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* One edge for the page's outlined pieces: hero buttons, about panels and the
     contact card. Two pixels thick, in the active theme's brand colour taken a
     step darker, so it follows the theme with nothing else to change. */
  .hero-actions,
  .about-panel,
  .contact-card {
    --edge-width: 2px;
    --edge: color-mix(in oklch, var(--color-brand-500) 78%, black);
    --edge-hover: color-mix(in oklch, var(--color-brand-500) 92%, black);
  }
  .hero-actions > a,
  .about-panel,
  .contact-card {
    border-width: var(--edge-width);
    border-style: solid;
    border-color: var(--edge);
  }
  .hero-actions > a:hover,
  .contact-card:hover {
    border-color: var(--edge-hover);
  }

  /* Hero buttons rise a touch and pick up a brand glow. `translate` is its own
     property, so it does not fight the press-down scale on :active. */
  .hero-actions > a {
    transition:
      translate 180ms ease-out,
      box-shadow 180ms ease-out,
      background-color 150ms ease-out,
      border-color 150ms ease-out;
  }
  .hero-actions > a:hover {
    translate: 0 -3px;
    box-shadow: 0 10px 24px -10px color-mix(in oklch, var(--color-brand-400) 70%, transparent);
  }

  /* About panels: the edge brightens a little on hover, and the
     content opens with a short slide where the browser can animate it. The
     transition lists the reveal's own properties too, so scrolling in is
     unchanged. */
  .about-panel[data-reveal] {
    transition:
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.1s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 200ms ease-out,
      box-shadow 200ms ease-out;
  }
  .about-panel:hover {
    border-color: var(--edge-hover);
  }
  .about-panel[open] {
    box-shadow: 0 8px 28px -16px color-mix(in oklch, var(--color-brand-500) 55%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .about-panel {
      interpolate-size: allow-keywords;
    }
    .about-panel::details-content {
      height: 0;
      overflow: clip;
      transition:
        height 280ms ease,
        content-visibility 280ms allow-discrete;
    }
    .about-panel[open]::details-content {
      height: auto;
    }
  }

  /* Contact card lifts slightly. It is a reveal target, so list the reveal's
     transitions again here. */
  [data-reveal].contact-card {
    transition:
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.1s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 200ms ease-out,
      box-shadow 200ms ease-out;
  }
  .contact-card:hover {
    box-shadow: 0 16px 40px -20px color-mix(in oklch, var(--color-brand-500) 60%, transparent);
  }
</style>

{/* For whoever opens the browser's developer tools. */}
<script is:inline define:vars={{ greeting: consoleGreeting, email: siteConfig.email }}>
  // eslint-disable-next-line no-console
  console.log('%c' + greeting + '\n%c' + email, 'font: 600 15px monospace; color: #0083fe', 'font: 13px monospace');
</script>

<script>
  // Light over the hero name: eases towards the cursor and fades in and out,
  // so it never jumps. Mouse and pen only; skipped for reduced motion.
  const hero = document.getElementById('home');
  const lines = Array.from(document.querySelectorAll<HTMLElement>('#home h1.hero-name > span'));
  const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
  if (hero && lines.length) {
    const goal = { x: 0, y: 0, on: 0 };
    const now = { x: 0, y: 0, on: 0 };
    let raf = 0;
    const tick = () => {
      raf = 0;
      now.x += (goal.x - now.x) * 0.16;
      now.y += (goal.y - now.y) * 0.16;
      now.on += (goal.on - now.on) * 0.12;
      for (const el of lines) {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', `${now.x - r.left}px`);
        el.style.setProperty('--my', `${now.y - r.top}px`);
        el.style.setProperty('--ms', now.on.toFixed(3));
      }
      const settled = Math.abs(goal.x - now.x) + Math.abs(goal.y - now.y) < 0.5 && Math.abs(goal.on - now.on) < 0.005;
      if (settled && goal.on === 0) {
        for (const el of lines) el.style.setProperty('--ms', '0');
      } else {
        raf = requestAnimationFrame(tick);
      }
    };
    const wake = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };
    hero.addEventListener('pointermove', (e) => {
      if (!motion.matches || e.pointerType === 'touch') return;
      if (goal.on === 0) {
        now.x = e.clientX;
        now.y = e.clientY;
      }
      goal.x = e.clientX;
      goal.y = e.clientY;
      goal.on = 1;
      wake();
    });
    hero.addEventListener('pointerleave', () => {
      goal.on = 0;
      wake();
    });
  }
</script>

<script>
  // Light over the dot texture in the content column: eases towards the cursor
  // and fades in and out. Mouse and pen only, and only where the texture is
  // drawn (1280px and up); skipped for reduced motion.
  const content = document.querySelector<HTMLElement>('.home-content');
  const wide = window.matchMedia('(min-width: 1280px)');
  const calm = window.matchMedia('(prefers-reduced-motion: no-preference)');
  if (content) {
    const goal = { x: 0, y: 0, on: 0 };
    const now = { x: 0, y: 0, on: 0 };
    let raf = 0;
    const tick = () => {
      raf = 0;
      const box = content.getBoundingClientRect();
      now.x += (goal.x - now.x) * 0.18;
      now.y += (goal.y - now.y) * 0.18;
      now.on += (goal.on - now.on) * 0.1;
      content.style.setProperty('--dx', `${now.x - box.left}px`);
      content.style.setProperty('--dy', `${now.y - box.top}px`);
      content.style.setProperty('--da', now.on.toFixed(3));
      const settled = Math.abs(goal.x - now.x) + Math.abs(goal.y - now.y) < 0.5 && Math.abs(goal.on - now.on) < 0.005;
      if (settled && goal.on === 0) content.style.setProperty('--da', '0');
      else raf = requestAnimationFrame(tick);
    };
    const wake = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };
    content.addEventListener('pointermove', (e) => {
      if (!wide.matches || !calm.matches || e.pointerType === 'touch') return;
      if (goal.on === 0) {
        now.x = e.clientX;
        now.y = e.clientY;
      }
      goal.x = e.clientX;
      goal.y = e.clientY;
      goal.on = 1;
      wake();
    });
    content.addEventListener('pointerleave', () => {
      goal.on = 0;
      wake();
    });
    // The page moves under a resting cursor, so the light has to follow the scroll.
    window.addEventListener(
      'scroll',
      () => {
        if (goal.on) wake();
      },
      { passive: true }
    );
  }
</script>

</LandingLayout>
