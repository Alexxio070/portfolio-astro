{
  "name": "portfolio-astro",
  "version": "1.0.0",
  "description": "Portfolio personal de Alejandro Vizán, hecho con Astro 7 y Tailwind CSS 4",
  "type": "module",
  "author": "Alejandro Vizán",
  "license": "MIT",
  "keywords": [
    "astro",
    "tailwindcss",
    "typescript",
    "portfolio"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Alexxio070/portfolio-astro"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "verify": "node scripts/verify-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run check && npm run test:run && npm run build && npm run verify",
    "test": "vitest",
    "test:run": "vitest run",
    "deploy:check": "npm run build && npx wrangler@4 deploy --dry-run",
    "deploy": "npm run validate && npx wrangler@4 deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/outfit": "^5.2.8",
    "@iconify-json/lucide": "^1.2.98",
    "@iconify-json/simple-icons": "^1.2.74",
    "astro": "7.3.1",
    "astro-icon": "^1.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fontkit": "^2.0.4",
    "png-to-ico": "^3.0.1",
    "schema-dts": "^1.1.2",
    "sharp": "^0.34.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
